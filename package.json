{
  "name": "meteo-weave",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1 --port 3000",
    "build": "bun --bun vite build",
    "build:vercel": "NITRO_PRESET=vercel bun run build",
    "start": "bun .output/server/index.mjs",
    "preview": "bun run start",
    "analyze": "ANALYZE=true bun run build",
    "routes:generate": "tsr generate",
    "postinstall": "bun run routes:generate",
    "prepare": "husky",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun run routes:generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run test:browser-guard && playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install",
    "check": "bun run check:agent && bun run format:check && bun run lint && bun run typecheck && bun run test",
    "check:all": "bun run check && bun run test:e2e",
    "ui:add": "shadcn add",
    "test:e2e:all": "bun run test:browser-guard && playwright test",
    "check:agent": "bun scripts/check-agent-contracts.ts",
    "agent:doctor": "node scripts/agent.mjs doctor",
    "agent:checkpoint": "node scripts/agent.mjs checkpoint",
    "agent:resume": "node scripts/agent.mjs resume",
    "agent:verify": "node scripts/agent.mjs verify",
    "agent:delivery": "node scripts/agent.mjs delivery",
    "agent:snapshot": "node scripts/agent.mjs snapshot",
    "test:browser-guard": "node scripts/test-browser-guard.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sentry/tanstackstart-react": "^11.6.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.61",
    "@tanstack/react-table": "^9.2.8",
    "@tanstack/react-virtual": "^3.14.15",
    "@turf/turf": "^7.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.55.0",
    "mapbox-gl": "^3.32.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.3",
    "react-hook-form": "^7.90.0",
    "react-map-gl": "^8.1.3",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.41",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "bun": "^1.4.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "nitro": "^3.0.260903-beta",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "bun": ">=1.4.3",
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.3"
}
