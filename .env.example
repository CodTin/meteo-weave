# No credentials are required to run the empty application shell.
# VITE_* values are public and embedded in the browser bundle at build time.
# Only a public Mapbox token (pk.*), restricted to your domains, belongs here.
VITE_MAPBOX_ACCESS_TOKEN=
VITE_ENABLE_TELEMETRY=false
VITE_SENTRY_DSN=

# Server-only runtime settings. Never give secrets a VITE_ prefix.
SENTRY_ENABLED=false
SENTRY_DSN=

# Optional build-only Sentry source-map upload credentials.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
