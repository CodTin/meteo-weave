# Agent commits: fast checks only, defer full test suite to CI
if [ -n "$AGENT_COMMIT" ]; then
  bun run format:check && bun run lint && bun run typecheck
else
  # Fast checks first (fail fast)
  bun run check:agent || exit 1
  bun run lint || exit 1

  # Format and staged files
  bunx --no-install lint-staged || exit 1

  # Type checking
  bun run typecheck || exit 1

  # Tests (can be skipped with SKIP_TESTS=1 for WIP commits)
  if [ -z "$SKIP_TESTS" ]; then
    bun run test
  fi
fi
